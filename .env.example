# ==============================================================================
# Environment Configuration — Aplikasi HR Backend
# Salin file ini menjadi ".env" lalu isi nilai sesuai environment (dev/staging/prod).
# JANGAN PERNAH commit file ".env" asli — hanya ".env.example" ini yang masuk git.
# Backend akan fail fast saat boot jika variabel wajib di bawah tidak terisi
# (lihat src/config/env.validation.ts).
# ==============================================================================

# --- Aplikasi ---
NODE_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=hr_backend_dev
DB_SCHEMA=public
DB_SSL=false
# Sinkronisasi skema otomatis oleh TypeORM. WAJIB false di semua environment —
# perubahan skema hanya lewat file migration (lihat backend-architecture-hr.md §5).
DB_SYNCHRONIZE=false
DB_LOGGING=false

# --- Auth / JWT (Phase 1 — Autentikasi) ---
# Generate secret acak yang panjang, mis: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# --- Enkripsi data sensitif at-rest: NIK, NPWP, no. rekening (Phase 1) ---
# Wajib diisi (min 16 karakter), mis: openssl rand -hex 32
# PENTING: sekali dipakai untuk data produksi, jangan pernah diganti tanpa
# proses re-encrypt — mengganti key akan membuat data lama tidak terbaca.
ENCRYPTION_KEY=

# ==============================================================================
# Variabel di bawah ini belum dipakai, disiapkan untuk fase mendatang sesuai
# Rekomendasi Stack di roadmap-aplikasi-hr.md §0.
# ==============================================================================

# --- Notifikasi Push (Firebase Cloud Messaging) — dipakai mulai Phase 2 ---
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY=

# --- Storage file: slip gaji, foto absen (S3-compatible / MinIO) — Phase 2 & 4 ---
# STORAGE_ENDPOINT=
# STORAGE_REGION=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
